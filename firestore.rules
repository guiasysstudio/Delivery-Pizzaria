rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasStaffProfile() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function staff() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function activeStaff() {
      return hasStaffProfile() && staff().active == true;
    }

    function isMaster() {
      return activeStaff() && staff().role == 'master';
    }

    function roleExists() {
      return activeStaff() &&
        staff().role != 'master' &&
        exists(/databases/$(database)/documents/roles/$(staff().role));
    }

    function roleData() {
      return get(/databases/$(database)/documents/roles/$(staff().role)).data;
    }

    function rolePermission(key) {
      return roleExists() &&
        roleData().get('active', true) != false &&
        roleData().get('permissions', {}).get(key, false) == true;
    }

    function hasPermission(key) {
      return isMaster() ||
        rolePermission(key) ||
        (
          key == 'ordersView' &&
          (
            rolePermission('ordersAccept') ||
            rolePermission('ordersPrepare') ||
            rolePermission('ordersDispatch') ||
            rolePermission('ordersComplete') ||
            rolePermission('ordersCancel')
          )
        ) ||
        (
          key == 'productsView' &&
          (
            rolePermission('productsCreate') ||
            rolePermission('productsEdit') ||
            rolePermission('productsDelete') ||
            rolePermission('categoriesManage') ||
            rolePermission('promotionsManage')
          )
        ) ||
        (
          key == 'cashView' &&
          rolePermission('cashOperate')
        );
    }

    function isOwnCustomer(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function ownCustomerPublicUpdate(uid) {
      return isOwnCustomer(uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name','phone','photoURL','customPhotoURL','defaultAddressId','updatedAt'
        ]) &&
        request.resource.data.get('identityComplete', false) ==
          resource.data.get('identityComplete', false);
    }

    function orderStatusUpdateOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['status','updatedAt','acceptedAt','completedAt','cancelledAt']);
    }

    function knownOrderStatus() {
      return request.resource.data.status in [
        'pending','accepted','preparing','ready','out_for_delivery','completed','cancelled'
      ];
    }

    function acceptTransition() {
      return hasPermission('ordersAccept') &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'accepted';
    }

    function prepareTransition() {
      return hasPermission('ordersPrepare') && (
        (
          resource.data.status == 'accepted' &&
          request.resource.data.status == 'preparing'
        ) ||
        (
          resource.data.status == 'preparing' &&
          request.resource.data.status == 'ready'
        )
      );
    }

    function dispatchTransition() {
      return hasPermission('ordersDispatch') &&
        resource.data.status == 'ready' &&
        request.resource.data.status == 'out_for_delivery';
    }

    function cancelTransition() {
      return hasPermission('ordersCancel') &&
        !(resource.data.status in ['completed','cancelled']) &&
        request.resource.data.status == 'cancelled';
    }

    function canUpdateOrder() {
      return orderStatusUpdateOnly() &&
        knownOrderStatus() &&
        (
          acceptTransition() ||
          prepareTransition() ||
          dispatchTransition() ||
          cancelTransition()
        );
    }

    match /staffLogins/{username} {
      // Mapeamento interno de login. O navegador usa resolveStaffLogin e nunca
      // recebe acesso direto à coleção, aos UIDs ou ao cadastro interno.
      allow read, write: if false;
    }

    match /users/{uid} {
      // Funcionários consultam somente o próprio perfil. A listagem completa e
      // todas as mutações são feitas pelo backend Master-only.
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if isMaster();
      allow create, update, delete: if false;
    }

    match /roles/{roleId} {
      allow read: if activeStaff();
      allow create, update, delete: if false;
    }

    match /customers/{uid} {
      // Perfil pessoal é privado do próprio cliente. A operação administrativa
      // usa apenas snapshots mínimos do pedido, nunca lê a ficha cadastral.
      allow create: if isOwnCustomer(uid) &&
        request.resource.data.get('identityComplete', false) == false;
      allow read: if isOwnCustomer(uid);
      allow update: if ownCustomerPublicUpdate(uid);
      allow delete: if false;

      match /addresses/{addressId} {
        allow read, create, update, delete: if isOwnCustomer(uid);
      }

      match /favorites/{productId} {
        allow read, create, update, delete: if isOwnCustomer(uid);
      }

      match /coupons/{couponId} {
        allow read: if isOwnCustomer(uid);
        allow write: if false;
      }
    }

    // CPF e índice de unicidade são exclusivamente server-side.
    // Nem o próprio cliente nem o painel administrativo acessam esses documentos
    // diretamente; as Cloud Functions usam Admin SDK e não passam pelas regras.
    match /customerPrivate/{uid} {
      allow read, write: if false;
    }

    match /cpfIndex/{hash} {
      allow read, write: if false;
    }

    match /settings/store {
      allow read: if true;
      allow create, delete: if hasPermission('settingsManage');
      allow update: if
        hasPermission('settingsManage') ||
        (
          hasPermission('ordersAccept') &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['autoAcceptOrders','updatedAt'])
        );
    }

    match /settings/{document=**} {
      allow read: if true;
      allow write: if hasPermission('settingsManage');
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if hasPermission('categoriesManage');
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if hasPermission('productsCreate');
      allow update: if hasPermission('productsEdit');
      allow delete: if hasPermission('productsDelete');
    }

    match /promotions/{promotionId} {
      allow read: if true;
      allow create, update, delete: if hasPermission('promotionsManage');
    }

    match /coupons/{couponId} {
      allow get: if signedIn() || hasPermission('couponsManage');
      allow list: if hasPermission('ordersView') || hasPermission('couponsManage');
      allow create, update, delete: if hasPermission('couponsManage');
    }

    match /cashSessions/{sessionId} {
      // O caixa é um livro financeiro: o navegador pode consultar, mas nunca
      // escrever diretamente. A Cloud Function manageCash serializa abertura,
      // movimentos, conclusão de pedidos e fechamento.
      allow read: if hasPermission('cashView');
      allow create, update, delete: if false;

      match /movements/{movementId} {
        allow read: if hasPermission('cashView');
        allow create, update, delete: if false;
      }
    }

    match /cashState/{stateId} {
      allow read: if hasPermission('cashView');
      allow create, update, delete: if false;
    }

    match /cashDays/{businessDate} {
      // Índice server-side das sessões do dia operacional. Permite várias
      // sessões sequenciais no mesmo dia, mas nunca dois caixas simultâneos.
      allow read, write: if false;
    }

    match /counters/orders {
      // Numeração de pedidos é mantida somente pela Cloud Function createOrder.
      // Clientes não podem reservar/manipular números diretamente.
      allow read: if signedIn();
      allow create, update: if false;
      allow delete: if isMaster();
    }

    match /orderPrivate/{orderId} {
      // Nome, telefone, e-mail e endereço completo ficam separados do livro
      // operacional. Apenas o próprio cliente pode ler sua cópia.
      allow read: if signedIn() && resource.data.customerId == request.auth.uid;
      allow write: if false;
    }

    match /orders/{orderId} {
      // Criação de pedido é exclusivamente server-side via Cloud Function createOrder.
      // A transição para "completed" também é exclusivamente server-side via
      // manageCash, que vincula a venda a um caixa aberto antes de contabilizá-la.
      allow create: if false;

      allow read: if hasPermission('ordersView') ||
        hasPermission('cashView') ||
        (signedIn() && resource.data.customerId == request.auth.uid);

      allow update: if canUpdateOrder();
      allow delete: if isMaster();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
