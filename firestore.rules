rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasStaffProfile() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function staff() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function activeStaff() {
      return hasStaffProfile() && staff().active == true;
    }

    function isMaster() {
      return activeStaff() && staff().role == 'master';
    }

    function roleExists() {
      return activeStaff() &&
        staff().role != 'master' &&
        exists(/databases/$(database)/documents/roles/$(staff().role));
    }

    function roleData() {
      return get(/databases/$(database)/documents/roles/$(staff().role)).data;
    }

    function hasPermission(key) {
      return isMaster() ||
        (
          roleExists() &&
          roleData().get('permissions', {}).get(key, false) == true
        );
    }

    function isOwnCustomer(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function orderStatusUpdateOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['status','updatedAt','acceptedAt','completedAt','cancelledAt']);
    }

    function knownOrderStatus() {
      return request.resource.data.status in [
        'pending','accepted','preparing','ready','out_for_delivery','completed','cancelled'
      ];
    }

    function acceptTransition() {
      return hasPermission('ordersAccept') &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'accepted';
    }

    function prepareTransition() {
      return hasPermission('ordersPrepare') && (
        (
          resource.data.status == 'accepted' &&
          request.resource.data.status == 'preparing'
        ) ||
        (
          resource.data.status == 'preparing' &&
          request.resource.data.status == 'ready'
        )
      );
    }

    function dispatchTransition() {
      return hasPermission('ordersDispatch') &&
        resource.data.status == 'ready' &&
        request.resource.data.status == 'out_for_delivery';
    }

    function completeTransition() {
      return hasPermission('ordersComplete') && (
        (
          resource.data.status == 'out_for_delivery' &&
          request.resource.data.status == 'completed'
        ) ||
        (
          resource.data.status == 'ready' &&
          resource.data.fulfillment == 'pickup' &&
          request.resource.data.status == 'completed'
        )
      );
    }

    function cancelTransition() {
      return hasPermission('ordersCancel') &&
        !(resource.data.status in ['completed','cancelled']) &&
        request.resource.data.status == 'cancelled';
    }

    function canUpdateOrder() {
      return orderStatusUpdateOnly() &&
        knownOrderStatus() &&
        (
          acceptTransition() ||
          prepareTransition() ||
          dispatchTransition() ||
          completeTransition() ||
          cancelTransition()
        );
    }

    match /staffLogins/{username} {
      // O mapa serve somente para traduzir "usuário" em credencial interna.
      // Ler o e-mail interno não concede acesso: toda autorização vem de /users e /roles.
      allow read: if true;
      allow create, update, delete: if hasPermission('usersManage');
    }

    match /users/{uid} {
      allow get: if hasPermission('usersManage') ||
        (signedIn() && request.auth.uid == uid);
      allow list: if hasPermission('usersManage');

      allow create: if hasPermission('usersManage') &&
        (
          isMaster() ||
          request.resource.data.role != 'master'
        );

      allow update: if hasPermission('usersManage') &&
        (
          isMaster() ||
          (
            resource.data.role != 'master' &&
            request.resource.data.role != 'master'
          )
        );

      allow delete: if hasPermission('usersManage') &&
        (
          isMaster() ||
          resource.data.role != 'master'
        );
    }

    match /roles/{roleId} {
      allow read: if activeStaff();
      allow create, update, delete: if hasPermission('rolesManage');
    }

    match /customers/{uid} {
      allow create: if isOwnCustomer(uid);
      allow read: if isOwnCustomer(uid) || hasPermission('customersView');
      allow update: if isOwnCustomer(uid) || hasPermission('customersView');
      allow delete: if isMaster();

      match /addresses/{addressId} {
        allow read, create, update, delete: if isOwnCustomer(uid);
        allow read: if hasPermission('customersView');
      }

      match /favorites/{productId} {
        allow read, create, update, delete: if isOwnCustomer(uid);
      }

      match /coupons/{couponId} {
        allow read: if isOwnCustomer(uid) || hasPermission('customersView');
        allow write: if false;
      }
    }

    match /settings/store {
      allow read: if true;
      allow create, delete: if hasPermission('settingsManage');
      allow update: if
        hasPermission('settingsManage') ||
        (
          hasPermission('ordersAccept') &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['autoAcceptOrders','updatedAt'])
        );
    }

    match /settings/{document=**} {
      allow read: if true;
      allow write: if hasPermission('settingsManage');
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if hasPermission('categoriesManage');
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if hasPermission('productsCreate');
      allow update: if hasPermission('productsEdit');
      allow delete: if hasPermission('productsDelete');
    }

    match /promotions/{promotionId} {
      allow read: if true;
      allow create, update, delete: if hasPermission('promotionsManage');
    }

    match /coupons/{couponId} {
      allow get: if signedIn() || hasPermission('couponsManage');
      allow list: if hasPermission('ordersView') || hasPermission('couponsManage');
      allow create, update, delete: if hasPermission('couponsManage');
    }

    match /cashSessions/{sessionId} {
      allow read: if hasPermission('cashView');
      allow create, update: if hasPermission('cashOperate');
      allow delete: if isMaster();

      match /movements/{movementId} {
        allow read: if hasPermission('cashView');
        allow create: if hasPermission('cashOperate');
        allow update, delete: if isMaster();
      }
    }

    match /cashState/{stateId} {
      allow read: if hasPermission('cashView');
      allow create, update, delete: if hasPermission('cashOperate');
    }

    match /counters/orders {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.value == 1;
      allow update: if signedIn() &&
        request.resource.data.value == resource.data.value + 1;
      allow delete: if isMaster();
    }

    match /orders/{orderId} {
      allow create: if signedIn() &&
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.orderNumber is int &&
        request.resource.data.orderNumber > 0 &&
        (
          request.resource.data.status == 'pending' ||
          (
            request.resource.data.status == 'accepted' &&
            get(/databases/$(database)/documents/settings/store).data.autoAcceptOrders == true
          )
        ) &&
        request.resource.data.customer.name is string &&
        request.resource.data.customer.name.size() > 0 &&
        request.resource.data.customer.phone is string &&
        request.resource.data.customer.phone.size() > 0 &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 &&
        request.resource.data.subtotal is number &&
        request.resource.data.total is number &&
        request.resource.data.total >= 0;

      allow read: if hasPermission('ordersView') ||
        hasPermission('cashView') ||
        (signedIn() && resource.data.customerId == request.auth.uid);

      allow update: if canUpdateOrder();
      allow delete: if isMaster();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
