rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function bootstrapMaster() {
      return signedIn() &&
        request.auth.token.email == 'master@delivery-pizzaria.local';
    }

    function hasStaffProfile() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function staff() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function activeStaff() {
      return bootstrapMaster() ||
        (hasStaffProfile() && staff().active == true);
    }

    function isMaster() {
      return bootstrapMaster() ||
        (activeStaff() && staff().role == 'master');
    }

    function isManager() {
      return activeStaff() &&
        (isMaster() || staff().role == 'manager');
    }

    function isCashier() {
      return activeStaff() &&
        (isManager() || staff().role == 'cashier');
    }

    function isKitchen() {
      return activeStaff() &&
        (isManager() || staff().role == 'kitchen');
    }

    function isOperator() {
      return activeStaff() &&
        (isManager() || staff().role == 'operator');
    }

    function isDelivery() {
      return activeStaff() &&
        (isManager() || staff().role == 'delivery');
    }

    function canReadOrders() {
      return activeStaff() &&
        (isMaster() || isManager() || isCashier() || isKitchen() || isOperator() || isDelivery());
    }

    function canUpdateOrders() {
      return canReadOrders();
    }

    function canManageCatalog() {
      return isMaster() || isManager();
    }

    function isOwnCustomer(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow get: if isMaster() || (signedIn() && request.auth.uid == uid);
      allow list: if isMaster();
      allow create, update, delete: if isMaster();
    }

    match /customers/{uid} {
      allow create: if isOwnCustomer(uid);
      allow read: if isOwnCustomer(uid) || isMaster() || isManager() || isCashier();
      allow update: if isOwnCustomer(uid) || isMaster() || isManager();
      allow delete: if isMaster();

      match /addresses/{addressId} {
        allow read, create, update, delete: if isOwnCustomer(uid);
        allow read: if isMaster() || isManager() || isCashier();
      }

      match /favorites/{productId} {
        allow read, create, update, delete: if isOwnCustomer(uid);
      }
    }

    match /settings/{document=**} {
      allow read: if true;
      allow write: if isMaster() || isManager();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if canManageCatalog();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if canManageCatalog();
    }

    match /counters/orders {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.value == 1;
      allow update: if signedIn() &&
        request.resource.data.value == resource.data.value + 1;
      allow delete: if isMaster();
    }

    match /orders/{orderId} {
      allow create: if signedIn() &&
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.orderNumber is int &&
        request.resource.data.orderNumber > 0 &&
        (
          request.resource.data.status == 'pending' ||
          (
            request.resource.data.status == 'accepted' &&
            get(/databases/$(database)/documents/settings/store).data.autoAcceptOrders == true
          )
        ) &&
        request.resource.data.customer.name is string &&
        request.resource.data.customer.name.size() > 0 &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 &&
        request.resource.data.subtotal is number &&
        request.resource.data.total is number &&
        request.resource.data.total >= 0;

      allow read: if canReadOrders() ||
        (signedIn() && resource.data.customerId == request.auth.uid);

      allow update: if canUpdateOrders();
      allow delete: if isMaster();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
