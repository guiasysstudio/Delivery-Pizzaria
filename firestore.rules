rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasStaffProfile() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function staff() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function activeStaff() {
      return hasStaffProfile() && staff().active == true;
    }

    function roleIs(role) {
      return activeStaff() && staff().role == role;
    }

    function isMaster() {
      return roleIs('master');
    }

    function isManager() {
      return activeStaff() && staff().role in ['master','manager'];
    }

    function isCashier() {
      return roleIs('cashier');
    }

    function isKitchen() {
      return roleIs('kitchen');
    }

    function isOperator() {
      return roleIs('operator');
    }

    function isDelivery() {
      return roleIs('delivery');
    }

    function canReadOrders() {
      return activeStaff() &&
        staff().role in ['master','manager','cashier','kitchen','operator','delivery'];
    }

    function canManageCatalog() {
      return activeStaff() && staff().role in ['master','manager'];
    }

    function isOwnCustomer(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function orderStatusUpdateOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['status','updatedAt','acceptedAt','completedAt','cancelledAt']);
    }

    function knownOrderStatus() {
      return request.resource.data.status in [
        'pending','accepted','preparing','ready','out_for_delivery','completed','cancelled'
      ];
    }

    function cashierTransition() {
      return isCashier() && (
        (resource.data.status == 'pending' &&
          request.resource.data.status in ['accepted','cancelled']) ||
        (resource.data.status == 'accepted' &&
          request.resource.data.status == 'cancelled')
      );
    }

    function kitchenTransition() {
      return isKitchen() && (
        (resource.data.status == 'accepted' &&
          request.resource.data.status == 'preparing') ||
        (resource.data.status == 'preparing' &&
          request.resource.data.status == 'ready')
      );
    }

    function deliveryTransition() {
      return isDelivery() && (
        (resource.data.status == 'ready' &&
          request.resource.data.status == 'out_for_delivery') ||
        (resource.data.status == 'out_for_delivery' &&
          request.resource.data.status == 'completed')
      );
    }

    function canUpdateOrder() {
      return orderStatusUpdateOnly() && knownOrderStatus() && (
        isMaster() ||
        isManager() ||
        isOperator() ||
        cashierTransition() ||
        kitchenTransition() ||
        deliveryTransition()
      );
    }

    match /staffLogins/{username} {
      allow read: if true;
      allow create, update, delete: if isMaster();
    }

    match /users/{uid} {
      allow get: if isMaster() || (signedIn() && request.auth.uid == uid);
      allow list: if isMaster();
      allow create, update, delete: if isMaster();
    }

    match /customers/{uid} {
      allow create: if isOwnCustomer(uid);
      allow read: if isOwnCustomer(uid) || isMaster() || isManager() || isCashier();
      allow update: if isOwnCustomer(uid) || isMaster() || isManager();
      allow delete: if isMaster();

      match /addresses/{addressId} {
        allow read, create, update, delete: if isOwnCustomer(uid);
        allow read: if isMaster() || isManager() || isCashier();
      }

      match /favorites/{productId} {
        allow read, create, update, delete: if isOwnCustomer(uid);
      }
    }

    match /settings/store {
      allow read: if true;
      allow create, delete: if isMaster() || isManager();
      allow update: if isMaster() || isManager() ||
        (
          isCashier() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['autoAcceptOrders', 'updatedAt'])
        );
    }

    match /settings/{document=**} {
      allow read: if true;
      allow write: if isMaster() || isManager();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if canManageCatalog();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if canManageCatalog();
    }

    match /counters/orders {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.value == 1;
      allow update: if signedIn() &&
        request.resource.data.value == resource.data.value + 1;
      allow delete: if isMaster();
    }

    match /orders/{orderId} {
      allow create: if signedIn() &&
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.orderNumber is int &&
        request.resource.data.orderNumber > 0 &&
        (
          request.resource.data.status == 'pending' ||
          (
            request.resource.data.status == 'accepted' &&
            get(/databases/$(database)/documents/settings/store).data.autoAcceptOrders == true
          )
        ) &&
        request.resource.data.customer.name is string &&
        request.resource.data.customer.name.size() > 0 &&
        request.resource.data.customer.phone is string &&
        request.resource.data.customer.phone.size() > 0 &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 &&
        request.resource.data.subtotal is number &&
        request.resource.data.total is number &&
        request.resource.data.total >= 0;

      allow read: if canReadOrders() ||
        (signedIn() && resource.data.customerId == request.auth.uid);

      allow update: if canUpdateOrder();
      allow delete: if isMaster();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
