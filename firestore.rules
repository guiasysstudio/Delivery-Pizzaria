rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasStaffProfile() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function staff() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function activeStaff() {
      return hasStaffProfile() && staff().active == true;
    }

    function isMaster() {
      return activeStaff() && staff().role == 'master';
    }

    function isManager() {
      return activeStaff() &&
        (staff().role == 'master' || staff().role == 'manager');
    }

    function isCashier() {
      return activeStaff() &&
        (staff().role == 'master' || staff().role == 'manager' || staff().role == 'cashier');
    }

    function isKitchen() {
      return activeStaff() &&
        (staff().role == 'master' || staff().role == 'manager' || staff().role == 'kitchen');
    }

    function isOperator() {
      return activeStaff() &&
        (staff().role == 'master' || staff().role == 'manager' || staff().role == 'operator');
    }

    function isDelivery() {
      return activeStaff() &&
        (staff().role == 'master' || staff().role == 'manager' || staff().role == 'delivery');
    }

    function canReadOrders() {
      return activeStaff() &&
        (staff().role in ['master','manager','cashier','kitchen','operator','delivery']);
    }

    function canUpdateOrders() {
      return canReadOrders();
    }

    function canManageCatalog() {
      return isMaster() || isManager();
    }

    function isOwnCustomer(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /staffLogins/{username} {
      // O e-mail interno não concede permissão por si só; ele serve apenas
      // para traduzir o nome de usuário digitado no login.
      allow read: if true;
      allow create, update, delete: if isMaster();
    }

    match /users/{uid} {
      allow get: if isMaster() || (signedIn() && request.auth.uid == uid);
      allow list: if isMaster();
      allow create, update, delete: if isMaster();
    }

    match /customers/{uid} {
      allow create: if isOwnCustomer(uid);
      allow read: if isOwnCustomer(uid) || isMaster() || isManager() || isCashier();
      allow update: if isOwnCustomer(uid) || isMaster() || isManager();
      allow delete: if isMaster();

      match /addresses/{addressId} {
        allow read, create, update, delete: if isOwnCustomer(uid);
        allow read: if isMaster() || isManager() || isCashier();
      }

      match /favorites/{productId} {
        allow read, create, update, delete: if isOwnCustomer(uid);
      }
    }

    match /settings/store {
      allow read: if true;
      allow create, delete: if isMaster() || isManager();
      allow update: if isMaster() || isManager() ||
        (
          isCashier() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['autoAcceptOrders', 'updatedAt'])
        );
    }

    match /settings/{document=**} {
      allow read: if true;
      allow write: if isMaster() || isManager();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if canManageCatalog();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if canManageCatalog();
    }

    match /counters/orders {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.value == 1;
      allow update: if signedIn() &&
        request.resource.data.value == resource.data.value + 1;
      allow delete: if isMaster();
    }

    match /orders/{orderId} {
      allow create: if signedIn() &&
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.orderNumber is int &&
        request.resource.data.orderNumber > 0 &&
        (
          request.resource.data.status == 'pending' ||
          (
            request.resource.data.status == 'accepted' &&
            get(/databases/$(database)/documents/settings/store).data.autoAcceptOrders == true
          )
        ) &&
        request.resource.data.customer.name is string &&
        request.resource.data.customer.name.size() > 0 &&
        request.resource.data.customer.phone is string &&
        request.resource.data.customer.phone.size() > 0 &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 &&
        request.resource.data.subtotal is number &&
        request.resource.data.total is number &&
        request.resource.data.total >= 0;

      allow read: if canReadOrders() ||
        (signedIn() && resource.data.customerId == request.auth.uid);

      allow update: if canUpdateOrders();
      allow delete: if isMaster();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
